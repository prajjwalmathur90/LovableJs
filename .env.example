# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=vibe
POSTGRES_PASSWORD=vibe
POSTGRES_DB=lovablejs
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vibe:vibe@localhost:5432/lovablejs

# ==========================================
# Temporal Server Configuration
# ==========================================
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal
TEMPORAL_DBNAME=temporal
TEMPORAL_VISIBILITY_DBNAME=temporal_visibility
TEMPORAL_PORT=7233

# ==========================================
# Temporal Web UI Configuration
# ==========================================
TEMPORAL_UI_PORT=8233
TEMPORAL_CORS_ORIGINS=http://localhost:8233,http://127.0.0.1:8233

# ==========================================
# Temporal Client & Worker Configuration
# ==========================================
# Use localhost:7233 when running worker/app locally on host.
# Use temporal:7233 if running inside the docker-compose network.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=lovablejs-task-queue

GEMINI_API_KEY=
